{
  "name": "playwright-typescript-cucumber-framework",
  "version": "1.0.0",
  "description": "Production-grade E2E automation framework — Playwright + TypeScript + Cucumber BDD",
  "author": "Yagyaraman M",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "cucumber-js --profile default",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:ci": "cucumber-js --profile ci",
    "test:headed": "HEADLESS=false cucumber-js --profile default",
    "test:firefox": "BROWSER=firefox cucumber-js --profile default",
    "test:webkit": "BROWSER=webkit cucumber-js --profile default",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf allure-results allure-report reports/videos reports/traces dist",
    "clean:all": "rimraf allure-results allure-report reports dist node_modules",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/html-formatter": "^21.3.1",
    "@playwright/test": "^1.43.1",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "allure-commandline": "^2.42.1",
    "allure-cucumberjs": "^3.0.4",
    "allure-js-commons": "^3.0.4",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "playwright": "^1.43.1",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
