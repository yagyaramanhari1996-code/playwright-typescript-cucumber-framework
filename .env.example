# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit secrets.
# ──────────────────────────────────────────────────────────────────────────

# Target application under test
BASE_URL=https://automationexercise.com

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Run headless (true/false) — set false locally to watch the browser
HEADLESS=true

# Slow down each Playwright action by N ms (useful for debugging)
SLOW_MO=0

# Default timeout for waits/actions, in milliseconds
TIMEOUT=30000

# Capture a screenshot when a scenario fails
SCREENSHOT_ON_FAILURE=true

# Record a Playwright trace on failure (viewable via `npx playwright show-trace`)
TRACE_ON_FAILURE=true

# Record video for every scenario (large files — off by default)
RECORD_VIDEO=false

# Logical environment name: dev | staging | prod
TEST_ENV=dev

# Log verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
